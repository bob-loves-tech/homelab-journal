---
export interface Props {
  title: string;
  description?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

import '../styles/global.css';

const { title, description, schema } = Astro.props;
const base = Astro.base || '/homelab-journal';
const siteUrl = Astro.site ?? new URL('https://bob-loves-tech.github.io');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const pageDescription = description ?? "Homelab Journal is Bobby Olejnik's practical, no-fluff running journal of Proxmox, Docker, LXC containers, homelab hardware, backups, monitoring, and self-hosted services.";
const schemaJson = schema ? JSON.stringify(schema) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={base + "/favicon.svg"} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}
  </head>
  <body>
    <header class="border-b border-[var(--color-surface-hover)] bg-[var(--color-bg)] sticky top-0 z-50 backdrop-blur-md">
      <nav class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href={base + "/"} class="text-xl font-bold tracking-tight text-[var(--color-text)]">
          Homelab<span class="text-[var(--color-primary-light)]">.journal</span>
        </a>
        <div class="flex gap-6 text-sm font-medium text-[var(--color-text-muted)]">
          <a href={base + "/#directory"} class="hover:text-[var(--color-text)]">Directory</a>
          <a href={base + "/#about"} class="hover:text-[var(--color-text)]">About</a>
        </div>
      </nav>
    </header>
    <main class="max-w-5xl mx-auto px-4 py-12">
      <slot />
    </main>
    <footer class="border-t border-[var(--color-surface-hover)] mt-24 py-8 text-center text-sm text-[var(--color-text-muted)]">
      <p>© {new Date().getFullYear()} Bobby Olejnik. Powered by Astro & Tailwind.</p>
    </footer>
  </body>
</html>
