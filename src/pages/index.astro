---
import BlogLayout from '../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categories = posts.reduce((acc, post) => {
  const cat = post.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(post);
  return acc;
}, {} as Record<string, typeof posts>);

const base = Astro.base || '/homelab-journal';
const siteUrl = Astro.site ?? new URL('https://bob-loves-tech.github.io');
const homeUrl = new URL(base + '/', siteUrl).toString();
const description = "Homelab Journal is Bobby Olejnik's practical, no-fluff running journal of Proxmox, Docker, LXC containers, homelab hardware, backups, monitoring, and self-hosted services.";
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Homelab Journal',
    url: homeUrl,
    description,
    author: {
      '@type': 'Person',
      name: 'Bobby Olejnik',
      url: 'https://github.com/bob-loves-tech'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Homelab Journal',
    url: homeUrl,
    description,
    isPartOf: {
      '@type': 'WebSite',
      name: 'Homelab Journal',
      url: homeUrl
    },
    about: [
      'homelab',
      'Proxmox',
      'Docker',
      'self-hosting',
      'home server hardware',
      'monitoring',
      'backups'
    ]
  }
];
---

<BlogLayout title="Homelab Journal" description={description} schema={schema}>
  <section class="text-center mb-16">
    <h1 class="text-5xl font-extrabold tracking-tight mb-4">Homelab <span class="text-[var(--color-primary-light)]">Journal</span></h1>
    <p class="text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
      A practical, no-fluff running journal of my homelab experiments. LXC containers, Docker, Proxmox scripts, and the occasional weird idea that actually worked.
    </p>
  </section>

  <section class="prose max-w-3xl mx-auto mb-16">
    <h2>What is Homelab Journal?</h2>
    <p>
      Homelab Journal is Bobby Olejnik's hands-on record of building, breaking, and improving a real home lab. The posts cover Proxmox hosts, Docker services, LXC containers, DNS, monitoring, backups, Windows Server, and the hardware choices behind the setup. The point is not polished enterprise theory. It is practical testing: what worked, what failed, what was worth keeping, and what Bobby would do differently next time.
    </p>
  </section>

  <section id="directory" class="mb-20">
    <h2 class="text-2xl font-bold mb-6 border-b border-[var(--color-surface-hover)] pb-2">What's Here</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {Object.entries(categories).map(([category, catPosts]) => (
        <div class="bg-[var(--color-surface)] p-6 rounded-xl border border-[var(--color-surface-hover)]">
          <h3 class="text-xl font-semibold text-[var(--color-primary-light)] mb-4">{category}</h3>
          <ul class="space-y-3">
            {catPosts.map(post => (
              <li>
                <a href={base + `/posts/${post.id}`} class="group block">
                  <span class="font-medium group-hover:text-[var(--color-primary-light)]">{post.data.title}</span>
                  <span class="block text-xs text-[var(--color-text-muted)] mt-1">{post.data.date.toLocaleDateString('en-GB', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="about" class="prose max-w-3xl border-t border-[var(--color-surface-hover)] pt-12 text-center mx-auto">
    <h2>Why This Exists</h2>
    <p>I break things so you don't have to. Or maybe I just like documenting the process. Either way, if it runs on Proxmox, it's probably here.</p>
    <p>Written by Bobby Olejnik, based on first-hand testing in his own homelab.</p>
    <p class="text-sm text-[var(--color-text-muted)] mt-8">Last updated: May 2026</p>
  </section>
</BlogLayout>
