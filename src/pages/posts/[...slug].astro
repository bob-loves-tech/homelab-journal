---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = Astro.base || '/homelab-journal';
const siteUrl = Astro.site ?? new URL('https://bob-loves-tech.github.io');
const postUrl = new URL(`${base}/posts/${post.id}/`, siteUrl).toString();
const description = `${post.data.title} - a Homelab Journal post by Bobby Olejnik about ${post.data.category}.`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  url: postUrl,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Bobby Olejnik',
    url: 'https://github.com/bob-loves-tech'
  },
  publisher: {
    '@type': 'Person',
    name: 'Bobby Olejnik',
    url: 'https://github.com/bob-loves-tech'
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl
  },
  articleSection: post.data.category
};
---

<BlogLayout title={post.data.title} description={description} schema={schema}>
  <article class="prose max-w-3xl">
    <Content />
    <hr class="my-8 border-[var(--color-surface-hover)]" />
    {post.data.related && post.data.related.length > 0 && (
      <div class="mb-8">
        <h3 class="text-lg font-semibold mb-3">Related Posts:</h3>
        <ul class="space-y-2">
          {post.data.related.map(r => (
            <li><a href={r.url}>{r.title}</a></li>
          ))}
        </ul>
      </div>
    )}
    <p class="text-sm text-[var(--color-text-muted)] mt-6">Written: {post.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</p>
  </article>
</BlogLayout>
