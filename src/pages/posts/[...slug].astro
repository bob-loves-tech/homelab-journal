---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = Astro.base || '/homelab-journal';
const siteUrl = Astro.site ?? new URL('https://bob-loves-tech.github.io');
const postUrl = new URL(`${base}/posts/${post.id}/`, siteUrl).toString();
const description = post.data.description;
const dateModified = post.data.updatedDate ?? post.data.date;
const homeUrl = new URL(`${base}/`, siteUrl).toString();
const categoryUrl = new URL(`${base}/#directory`, siteUrl).toString();
const articleImage = post.data.heroImage ? new URL(post.data.heroImage, siteUrl).toString() : undefined;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description,
    url: postUrl,
    datePublished: post.data.date.toISOString(),
    dateModified: dateModified.toISOString(),
    author: {
      '@type': 'Person',
      name: 'Bobby Olejnik',
      url: 'https://github.com/bob-loves-tech'
    },
    publisher: {
      '@type': 'Person',
      name: 'Bobby Olejnik',
      url: 'https://github.com/bob-loves-tech'
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': postUrl
    },
    articleSection: post.data.category,
    keywords: post.data.tags,
    ...(articleImage ? { image: articleImage } : {})
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: homeUrl
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: post.data.category,
        item: categoryUrl
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.data.title,
        item: postUrl
      }
    ]
  }
];
---

<BlogLayout title={post.data.title} description={description} ogType="article" image={post.data.heroImage} schema={schema}>
  <article class="prose max-w-3xl">
    <nav aria-label="Breadcrumb" class="not-prose text-sm text-[var(--color-text-muted)] mb-8">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href={base + "/"}>Home</a></li>
        <li aria-hidden="true">-&gt;</li>
        <li><a href={base + "/#directory"}>{post.data.category}</a></li>
        <li aria-hidden="true">-&gt;</li>
        <li aria-current="page" class="text-[var(--color-text)]">{post.data.title}</li>
      </ol>
    </nav>
    <Content />
    <hr class="my-8 border-[var(--color-surface-hover)]" />
    {post.data.related && post.data.related.length > 0 && (
      <div class="mb-8">
        <h3 class="text-lg font-semibold mb-3">Related Posts:</h3>
        <ul class="space-y-2">
          {post.data.related.map(r => (
            <li><a href={r.url}>{r.title}</a></li>
          ))}
        </ul>
      </div>
    )}
    <p class="text-sm text-[var(--color-text-muted)] mt-6">Written: {post.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</p>
  </article>
</BlogLayout>
